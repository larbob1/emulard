+/// Enables the existing wave-wide retry for selected DXBC container
+/// digests, without widening unrelated shaders in the same run.
+fn wave_wide_for_container(digest: &[u8; 16]) -> bool {
+    static DIGESTS: std::sync::OnceLock<Vec<[u8; 16]>> = std::sync::OnceLock::new();
+    DIGESTS
+        .get_or_init(|| {
+            std::env::var("VICTORY_WAVE_WIDE_DIGESTS")
+                .unwrap_or_default()
+                .split(',')
+                .filter_map(|entry| {
+                    let hex = entry.trim().as_bytes();
+                    if hex.len() != 32 {
+                        return None;
+                    }
+                    let mut digest = [0; 16];
+                    for (byte, pair) in digest.iter_mut().zip(hex.chunks_exact(2)) {
+                        *byte = u8::from_str_radix(std::str::from_utf8(pair).ok()?, 16).ok()?;
+                    }
+                    Some(digest)
+                })
+                .collect()
+        })
+        .contains(digest)
+}
