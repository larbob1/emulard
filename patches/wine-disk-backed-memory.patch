+/// Back this section with a sparse file so the host can reclaim its pages
+/// through ordinary filesystem writeback instead of keeping them in swap.
+fn disk_backed_section(directory: &std::path::Path, size: usize) -> std::io::Result<HANDLE> {
+    use std::os::windows::{fs::OpenOptionsExt, io::AsRawHandle};
+    use windows_sys::Win32::Storage::FileSystem::FILE_FLAG_DELETE_ON_CLOSE;
+
+    static NEXT_FILE: AtomicUsize = AtomicUsize::new(0);
+    let file = loop {
+        let index = NEXT_FILE.fetch_add(1, Ordering::Relaxed);
+        let path = directory.join(format!("victory-xmem-{}-{index}.bin", std::process::id()));
+        match std::fs::OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create_new(true)
+            .custom_flags(FILE_FLAG_DELETE_ON_CLOSE)
+            .open(path)
+        {
+            Err(error) if error.kind() == std::io::ErrorKind::AlreadyExists => continue,
+            result => break result?,
+        }
+    };
+    file.set_len(size as u64)?;
+    // SAFETY: the file handle is valid for the call. The section retains
+    // its own reference to the file after the handle closes.
+    let section = unsafe {
+        CreateFileMappingW(
+            file.as_raw_handle(),
+            std::ptr::null(),
+            PAGE_READWRITE,
+            0,
+            0,
+            std::ptr::null(),
+        )
+    };
+    if section.is_null() {
+        return Err(std::io::Error::last_os_error());
+    }
+    Ok(section)
+}
