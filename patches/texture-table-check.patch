+/// Reads a span from the backing section selected by the live view table.
+#[cfg(feature = "diagnostics")]
+pub(crate) fn read_view_backing(at: usize, out: &mut [u8], _mapped: &crate::watch::Reading) -> bool {
+    use windows_sys::Win32::System::Memory::{FILE_MAP_READ, MapViewOfFile, UnmapViewOfFile};
+
+    let (section, offset) = {
+        let v = views();
+        let Some((&base, &(len, section, offset))) = v.views.range(..=at).next_back() else {
+            return false;
+        };
+        let within = at - base;
+        if within >= len || out.len() > len - within
+            || !v.sections.iter().any(|&(handle, _, committed)| handle == section && committed)
+        {
+            return false;
+        }
+        (section, offset + within as u64)
+    };
+    let aligned = offset / K64 as u64 * K64 as u64;
+    let within = (offset - aligned) as usize;
+    // SAFETY: the caller holds the mapping read guard and the title view
+    // retains the section. This temporary read-only view covers the span.
+    let view = unsafe {
+        MapViewOfFile(
+            section as *mut c_void, FILE_MAP_READ, (aligned >> 32) as u32, aligned as u32,
+            within + out.len(),
+        )
+    };
+    if view.Value.is_null() {
+        return false;
+    }
+    let read = crate::host::read_into(view.Value.cast::<u8>().wrapping_add(within), out);
+    // SAFETY: just created above and not shared with another thread.
+    unsafe { UnmapViewOfFile(view) };
+    read
 }
 
