+/// Compare the texture's existing view with the section selected by the
+/// software table. Concurrent game writes can change bytes between reads.
+#[cfg(feature = "diagnostics")]
+fn check_backing_view(memory: *const u8, size: usize, mapped: &crate::watch::Reading) {
+    use std::sync::OnceLock;
+    use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+
+    static FIRST_FRAME: OnceLock<Option<u64>> = OnceLock::new();
+    static VISITS: AtomicU64 = AtomicU64::new(0);
+    static RESULTS: [AtomicU64; 4] = [const { AtomicU64::new(0) }; 4];
+    let Some(first) = *FIRST_FRAME.get_or_init(|| {
+        std::env::var("VICTORY_TEXTURE_TABLE_CHECK").ok()?.parse().ok()
+    }) else {
+        return;
+    };
+    let frame = crate::queue::presented();
+    if frame < first || size == 0 {
+        return;
+    }
+    const STRIDE: u64 = 16;
+    const LIMIT: u64 = 512;
+    let visit = VISITS.fetch_add(1, Relaxed);
+    let sample = visit / STRIDE + 1;
+    if !visit.is_multiple_of(STRIDE) || sample > LIMIT {
+        return;
+    }
+
+    let page_left = 65536 - (memory as usize % 65536);
+    let bytes = size.min(page_left);
+    let mut before = vec![0; bytes];
+    let mut backing = vec![0; bytes];
+    let result = if !crate::host::read_into(memory, &mut before)
+        || !crate::inplace::read_view_backing(memory as usize, &mut backing, mapped)
+    {
+        0
+    } else if before == backing {
+        1
+    } else {
+        let mut after = vec![0; bytes];
+        if !crate::host::read_into(memory, &mut after) || after != before {
+            2
+        } else {
+            3
+        }
+    };
+    let status = ["skipped", "matched", "changed", "different"][result];
+    tracing::debug!(
+        target: "victory_gpu::texture_table", frame, at = memory as usize,
+        texture_bytes = size, bytes, status, "texture backing sample"
+    );
+    RESULTS[result].fetch_add(1, Relaxed);
+    if result == 3 {
+        tracing::warn!(frame, bytes, "texture table check found different bytes");
+    }
+    if sample == 1 || sample.is_multiple_of(32) || result == 3 {
+        let [skipped, matched, changed, different] = RESULTS.each_ref().map(|n| n.load(Relaxed));
+        tracing::info!(frame, sample, skipped, matched, changed, different, "texture table check");
+    }
+}
