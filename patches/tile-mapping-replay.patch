 /// Bytes per mapped page.
 const PAGE: u64 = 64 << 10;
 
+/// Records mapping requests without reading title memory or changing the
+/// order in which the live mapper sees them.
+#[cfg(feature = "diagnostics")]
+fn trace_page_ranges(destination: u64, pool: u64, pool_pages: u32, ranges: &[PageRange]) {
+    use std::io::{BufWriter, Write};
+    use std::sync::{Mutex, OnceLock};
+
+    struct Trace {
+        out: BufWriter<std::fs::File>,
+        first_frame: u64,
+        remaining: usize,
+    }
+    static TRACE: OnceLock<Option<Mutex<Trace>>> = OnceLock::new();
+    let Some(trace) = TRACE.get_or_init(|| {
+        let path = std::env::var_os("VICTORY_PAGE_TRACE")?;
+        let out = match std::fs::File::create(path) {
+            Ok(file) => BufWriter::new(file),
+            Err(error) => {
+                tracing::warn!(%error, "cannot open page mapping trace");
+                return None;
+            }
+        };
+        let first_frame = std::env::var("VICTORY_PAGE_TRACE_AFTER")
+            .ok()
+            .and_then(|value| value.parse().ok())
+            .unwrap_or(0);
+        Some(Mutex::new(Trace { out, first_frame, remaining: 65_536 }))
+    }) else {
+        return;
+    };
+    let frame = presented();
+    let mut trace = trace.lock().unwrap_or_else(|e| e.into_inner());
+    if trace.remaining == 0 || frame < trace.first_frame {
+        return;
+    }
+    let mut at = destination;
+    for range in ranges.iter().take(trace.remaining) {
+        if writeln!(
+            trace.out, "{frame},{at},{pool},{pool_pages},{},{},{}",
+            range.kind, range.start, range.count
+        ).is_err() {
+            trace.remaining = 0;
+            return;
+        }
+        trace.remaining -= 1;
+        at += u64::from(range.count) * PAGE;
+    }
+    if let Err(error) = trace.out.flush() {
+        tracing::warn!(%error, "cannot flush page mapping trace");
+        trace.remaining = 0;
+    }
+}
