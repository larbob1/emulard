+fn check_views() -> bool {
+    static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var_os("VICTORY_MAPPED_BY_VIEWS").is_some_and(|v| v == "1"))
+}
+
+/// A fully covered span can use the view table instead of probing its
+/// host pages. Gaps and other allocations use the host query. The
+/// mapping read guard keeps the view stable for this check.
+fn mapped_by_views(at: usize, len: usize, _mapped: &crate::watch::Reading) -> bool {
+    if !check_views() || at.checked_add(len.max(1)).is_none()
+    {
+        return false;
+    }
+    if matches!(crate::inplace::cover(at, len), crate::inplace::Cover::Run(..) | crate::inplace::Cover::Scattered) {
+        crate::framelog::add(crate::framelog::T::TextureViewChecks, 1);
+        return true;
+    }
+    false
+}
+
 /// How many bytes of `[at, at + len)` are committed memory: all of a
 /// texture that is there, some of one streaming in (its smaller mips lie
 /// at the start of its memory, and their pages are mapped first), none of
