+    /// An outer loop whose header branches into an inner loop. The block `p`
+    /// ends the inner loop and branches either back to the inner header or
+    /// back to the outer one. Both headers have a phi fed by `p`.
+    fn continue_outer_from_inner() -> Nested {
+        let mut m = Module::default();
+        let i32t = m.int(32);
+        let (entry, outer, inner, p, exit) = (
+            m.new_block(),
+            m.new_block(),
+            m.new_block(),
+            m.new_block(),
+            m.new_block(),
+        );
+        let (zero, one, two) = (m.i32(0), m.i32(1), m.i32(2));
+        m.terminate(entry, Term::Br(outer));
+        let outer_phi = m.phi(outer, i32t);
+        let cond_outer = m.cmp(outer, pred::IULT, outer_phi, two);
+        m.terminate(outer, Term::CondBr(cond_outer, inner, exit));
+        let inner_phi = m.phi(inner, i32t);
+        let cond_inner = m.cmp(inner, pred::IULT, inner_phi, two);
+        m.terminate(inner, Term::CondBr(cond_inner, p, exit));
+        let from_p = m.bin(p, Bin::Add, inner_phi, one);
+        let cond_p = m.cmp(p, pred::EQ, from_p, one);
+        m.terminate(p, Term::CondBr(cond_p, inner, outer));
+        m.terminate(exit, Term::Ret);
+        m.set_phi(outer_phi, vec![(zero, entry), (from_p, p)]);
+        m.set_phi(inner_phi, vec![(outer_phi, outer), (from_p, p)]);
+        Nested {
+            m,
+            entry,
+            outer,
+            inner,
+            p,
+            outer_phi,
+            inner_phi,
+            from_p,
+            from_entry: zero,
+        }
+    }
+
+    fn back_edge_target_counts(m: &Module) -> Vec<usize> {
+        let (order, pos) = m.positions();
+        order
+            .iter()
+            .map(|&b| m.back_edge_targets(b, &pos).len())
+            .collect()
+    }
