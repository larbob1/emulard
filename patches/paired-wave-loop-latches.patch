+    /// A loop with one back edge is not changed, so its bytes stay the same.
+    #[test]
+    fn a_single_latch_loop_is_left_alone() {
+        let mut m = synthetic(8, 17, 3);
+        let blocks = m.blocks.len();
+        let terms: Vec<_> = m.blocks.iter().map(|b| format!("{:?}", b.term)).collect();
+        m.single_latch_loops();
+        assert_eq!(m.blocks.len(), blocks);
+        let after: Vec<_> = m.blocks.iter().map(|b| format!("{:?}", b.term)).collect();
+        assert_eq!(terms, after);
+        let bytes = m.write();
+        assert_eq!(m.blocks.len(), blocks);
+        assert_eq!(bytes, synthetic(8, 17, 3).write());
+    }
