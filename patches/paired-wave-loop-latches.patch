+/// Returns `term` with each branch arm that goes to `from` changed to go to `to`.
+fn retarget(term: Option<Term>, from: usize, to: usize) -> Option<Term> {
+    let swap = |t: usize| if t == from { to } else { t };
+    match term {
+        Some(Term::Br(t)) => Some(Term::Br(swap(t))),
+        Some(Term::CondBr(c, t, f)) => Some(Term::CondBr(c, swap(t), swap(f))),
+        other => other,
+    }
+}
