+    /// The predecessors of `header` whose edge to it goes backwards in reverse postorder.
+    fn back_edge_preds(m: &Module, header: usize) -> Vec<usize> {
+        let order = m.reverse_postorder();
+        let mut pos = vec![usize::MAX; m.blocks.len()];
+        for (n, &b) in order.iter().enumerate() {
+            pos[b] = n;
+        }
+        order
+            .iter()
+            .copied()
+            .filter(|&p| successors(m.blocks[p].term).contains(&header) && pos[header] <= pos[p])
+            .collect()
+    }
