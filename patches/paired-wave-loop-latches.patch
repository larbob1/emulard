+    /// A header has three latches and two phis. One latch is a conditional
+    /// branch with both arms to the header, and one also exits the loop. After
+    /// the write there is one new latch, and its phis hold the per-latch values.
+    #[test]
+    fn several_back_edges_become_one_latch() {
+        let mut m = Module::default();
+        let i32t = m.int(32);
+        let (entry, head, a, b, mid, c, d, exit) = (
+            m.new_block(),
+            m.new_block(),
+            m.new_block(),
+            m.new_block(),
+            m.new_block(),
+            m.new_block(),
+            m.new_block(),
+            m.new_block(),
+        );
+        let (zero, one, two, three) = (m.i32(0), m.i32(1), m.i32(2), m.i32(3));
+        m.terminate(entry, Term::Br(head));
+        let counter = m.phi(head, i32t);
+        let data = m.phi(head, i32t);
+        let next = m.bin(head, Bin::Add, counter, one);
+        let cond = m.cmp(head, pred::IULT, next, three);
+        m.terminate(head, Term::CondBr(cond, a, exit));
+        let cond_a = m.cmp(a, pred::EQ, next, two);
+        m.terminate(a, Term::CondBr(cond_a, b, mid));
+        let from_b = m.bin(b, Bin::Add, data, two);
+        let cond_b = m.cmp(b, pred::EQ, next, one);
+        m.terminate(b, Term::CondBr(cond_b, head, head));
+        let cond_m = m.cmp(mid, pred::EQ, next, three);
+        m.terminate(mid, Term::CondBr(cond_m, c, d));
+        m.terminate(c, Term::Br(head));
+        let from_d = m.bin(d, Bin::Add, data, three);
+        let cond_d = m.cmp(d, pred::EQ, next, zero);
+        m.terminate(d, Term::CondBr(cond_d, head, exit));
+        m.terminate(exit, Term::Ret);
+        m.set_phi(
+            counter,
+            vec![(zero, entry), (two, b), (three, c), (next, d)],
+        );
+        m.set_phi(
+            data,
+            vec![(zero, entry), (from_b, b), (data, c), (from_d, d)],
+        );
+        let sorted = |mut v: Vec<usize>| {
+            v.sort_unstable();
+            v
+        };
+        assert_eq!(sorted(back_edge_preds(&m, head)), [b, c, d]);
+        let blocks = m.blocks.len();
+
+        assert!(!m.write().is_empty());
+
+        assert_eq!(m.blocks.len(), blocks + 1);
+        let latch = blocks;
+        assert_eq!(back_edge_preds(&m, head), [latch]);
+        assert!(matches!(m.blocks[latch].term, Some(Term::Br(h)) if h == head));
+        assert!(
+            matches!(m.blocks[b].term, Some(Term::CondBr(_, x, y)) if x == latch && y == latch)
+        );
+        assert!(matches!(m.blocks[c].term, Some(Term::Br(x)) if x == latch));
+        assert!(matches!(m.blocks[d].term, Some(Term::CondBr(_, x, y)) if x == latch && y == exit));
+        assert!(matches!(m.blocks[a].term, Some(Term::CondBr(_, x, y)) if x == b && y == mid));
+        let joined: Vec<V> = m.blocks[latch].phis.iter().map(|&i| V::Inst(i)).collect();
+        assert_eq!(joined.len(), 2);
+        let live = m.live();
+        assert!(
+            joined
+                .iter()
+                .all(|&v| matches!(v, V::Inst(i) if live[i as usize]))
+        );
+        assert_eq!(
+            phi_incoming(&m, joined[0]),
+            [(two, b), (three, c), (next, d)]
+        );
+        assert_eq!(
+            phi_incoming(&m, joined[1]),
+            [(from_b, b), (data, c), (from_d, d)]
+        );
+        assert_eq!(
+            phi_incoming(&m, counter),
+            [(zero, entry), (joined[0], latch)]
+        );
+        assert_eq!(phi_incoming(&m, data), [(zero, entry), (joined[1], latch)]);
+    }
