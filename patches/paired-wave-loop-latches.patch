+    /// A block with two back edges, to an inner and an outer header, keeps the
+    /// inner one. The outer one goes through a new block that the layout does
+    /// not fold back into it, and the outer phi takes its value from there.
+    #[test]
+    fn a_block_with_two_back_edges_keeps_the_inner_one() {
+        let Nested {
+            mut m,
+            entry,
+            outer,
+            inner,
+            p,
+            outer_phi,
+            inner_phi,
+            from_p,
+            from_entry,
+        } = continue_outer_from_inner();
+        assert_eq!(back_edge_target_counts(&m).iter().max(), Some(&2));
+        let blocks = m.blocks.len();
+
+        assert!(!m.write().is_empty());
+
+        assert_eq!(m.blocks.len(), blocks + 1);
+        let own = blocks;
+        assert!(matches!(m.blocks[p].term, Some(Term::CondBr(_, x, y)) if x == inner && y == own));
+        assert!(matches!(m.blocks[own].term, Some(Term::Br(h)) if h == outer));
+        assert_eq!(back_edge_preds(&m, inner), [p]);
+        assert_eq!(back_edge_preds(&m, outer), [own]);
+        assert!(back_edge_target_counts(&m).iter().all(|&n| n <= 1));
+        assert_eq!(
+            phi_incoming(&m, outer_phi),
+            [(from_entry, entry), (from_p, own)]
+        );
+        assert_eq!(
+            phi_incoming(&m, inner_phi),
+            [(outer_phi, outer), (from_p, p)]
+        );
+        let fold = m.folded_latches(&m.reverse_postorder());
+        assert_eq!(fold[own], None);
+    }
