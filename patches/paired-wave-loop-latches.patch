+    /// The incoming (value, block) list of a phi.
+    fn phi_incoming(m: &Module, v: V) -> Vec<(V, usize)> {
+        let V::Inst(i) = v else { panic!() };
+        let Op::Phi(inc) = &m.insts[i as usize].op else {
+            panic!()
+        };
+        inc.clone()
+    }
