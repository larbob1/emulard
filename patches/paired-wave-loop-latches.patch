+    /// A header that is its own latch and also has a second latch.
+    #[test]
+    fn a_self_loop_with_two_back_edges_through_one_block_is_merged() {
+        let mut m = Module::default();
+        let i32t = m.int(32);
+        let (entry, head, side) = (m.new_block(), m.new_block(), m.new_block());
+        let (zero, one) = (m.i32(0), m.i32(1));
+        m.terminate(entry, Term::Br(head));
+        let counter = m.phi(head, i32t);
+        let next = m.bin(head, Bin::Add, counter, one);
+        let cond = m.cmp(head, pred::IULT, next, one);
+        m.terminate(head, Term::CondBr(cond, head, side));
+        m.terminate(side, Term::Br(head));
+        m.set_phi(counter, vec![(zero, entry), (next, head), (one, side)]);
+        assert_eq!(back_edge_preds(&m, head), [head, side]);
+        assert!(!m.write().is_empty());
+        let latch = m.blocks.len() - 1;
+        assert_eq!(back_edge_preds(&m, head), [latch]);
+        assert_eq!(
+            phi_incoming(&m, counter)[1..],
+            [(V::Inst(m.blocks[latch].phis[0]), latch)],
+        );
+    }
