From: uiliannn <uiliaannn@gmail.com>
Date: Tue, 24 Nov 2026 22:42:53 -0300
Subject: [PATCH] shader: reconcile signature row interpolation and keep
 console element order

---
 crates/victory-shader/src/emit/container.rs | 45 ++++++++++--
 crates/victory-shader/src/emit/shader.rs    | 79 +++++++++++++++++++++
 2 files changed, 120 insertions(+), 4 deletions(-)

diff --git a/crates/victory-shader/src/emit/container.rs b/crates/victory-shader/src/emit/container.rs
index 3c346d9..b23eca9 100644
--- a/crates/victory-shader/src/emit/container.rs
+++ b/crates/victory-shader/src/emit/container.rs
@@ -89,10 +89,12 @@ pub(crate) fn signature(elements: &[SigElement], input: bool) -> Vec<u8> {
             }
         }
     }
-    let mut order: Vec<usize> = (0..elements.len()).collect();
-    order.sort_by_key(|&i| (elements[i].row.unwrap_or(u32::MAX), elements[i].col));
-    for i in order {
-        let (e, offset) = (&elements[i], offsets[i]);
+    // The rows stay in the console's element order: the module's signature
+    // metadata lists them that way, and the validator compares the part to it
+    // element by element (a row's columns may be interleaved between
+    // semantics).
+    for (i, e) in elements.iter().enumerate() {
+        let offset = offsets[i];
         let used = e.usage << e.col;
         let rw = if input { used } else { !used & 0xf };
         for v in [
@@ -416,4 +418,39 @@ mod tests {
             .collect();
         assert_eq!(hex, "900150983cd24fb0d6963f7d28e17f72");
     }
+
+    #[test]
+    fn signature_keeps_the_console_element_order_within_a_row() {
+        // Two semantics share row 2 (columns 0 and 3). The module's signature
+        // metadata lists TEXCOORD first and the validator compares the part
+        // to it element by element, so the part must keep that order rather
+        // than sort by column.
+        let el = |name: &str, kind, comp, row, col, usage| SigElement {
+            name: name.into(),
+            index: 0,
+            kind,
+            comp,
+            interp: 1,
+            row: Some(row),
+            col,
+            cols: 1,
+            usage,
+            half: false,
+        };
+        let part = signature(
+            &[
+                el("TEXCOORD", 0, 9, 2, 0, 7),
+                el("COLOR", 0, 9, 2, 3, 8),
+            ],
+            true,
+        );
+        let name_at = |i: usize| {
+            let at = 8 + 32 * i;
+            let offset = u32::from_le_bytes(part[at + 4..at + 8].try_into().unwrap()) as usize;
+            let end = part[offset..].iter().position(|&b| b == 0).unwrap();
+            std::str::from_utf8(&part[offset..offset + end]).unwrap()
+        };
+        assert_eq!(name_at(0), "TEXCOORD");
+        assert_eq!(name_at(1), "COLOR");
+    }
 }
diff --git a/crates/victory-shader/src/emit/shader.rs b/crates/victory-shader/src/emit/shader.rs
index 28a36f1..1b31b6e 100644
--- a/crates/victory-shader/src/emit/shader.rs
+++ b/crates/victory-shader/src/emit/shader.rs
@@ -641,6 +641,15 @@ impl Shader {
         }
 
         let graphics = self.threads.is_none() || self.mesh.is_some();
+        // DXIL requires every signature element packed into the same row to
+        // share one interpolation mode. Integer / SV_IsFrontFace elements must
+        // stay constant (1); otherwise a read element's mode wins over unread
+        // siblings in the same row.
+        if self.pixel {
+            reconcile_row_interp(&mut self.inputs);
+        } else if graphics {
+            reconcile_row_interp(&mut self.outputs);
+        }
         if graphics {
             // shortcut: every output is declared to depend on every input; the
             // exact sets need a dependence pass. Drivers read this state.
@@ -888,3 +897,73 @@ impl Shader {
         Some(self.m.md_node(list))
     }
 }
+
+/// Ensures elements sharing a signature row declare one DXIL interpolation
+/// mode. Any integer or `SV_IsFrontFace` element forces the row to `constant`
+/// (`1`); otherwise, a used element's mode overrides unread siblings.
+fn reconcile_row_interp(elems: &mut [SigElement]) {
+    let mut row_mode: std::collections::HashMap<u32, (bool, Option<u8>)> =
+        std::collections::HashMap::new();
+    for e in elems.iter() {
+        let Some(row) = e.row else { continue };
+        if e.interp == 0 {
+            continue;
+        }
+        let entry = row_mode.entry(row).or_insert((false, None));
+        if e.kind == 13 || e.comp != 9 {
+            entry.0 = true;
+        } else if e.usage != 0 && entry.1.is_none() {
+            entry.1 = Some(e.interp);
+        }
+    }
+    for e in elems.iter_mut() {
+        let Some(row) = e.row else { continue };
+        if e.interp == 0 {
+            continue;
+        }
+        if let Some(&(force_const, used_mode)) = row_mode.get(&row) {
+            if force_const {
+                e.interp = 1;
+            } else if e.usage == 0
+                && let Some(m) = used_mode
+            {
+                e.interp = m;
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn elem(name: &str, kind: u8, comp: u8, interp: u8, row: u32, col: u8, usage: u8) -> SigElement {
+        SigElement {
+            name: name.into(),
+            index: 0,
+            kind,
+            comp,
+            interp,
+            row: Some(row),
+            col,
+            cols: 1,
+            usage,
+            half: false,
+        }
+    }
+
+    #[test]
+    fn reconcile_row_interp_matches_constant_and_used_siblings() {
+        let mut elems = vec![
+            elem("TEXCOORD", 0, 9, 2, 7, 0, 0),
+            elem("SV_IsFrontFace", 13, 5, 1, 7, 1, 1),
+            elem("TEXCOORD", 0, 9, 2, 8, 0, 0),
+            elem("TEXCOORD", 0, 9, 3, 8, 1, 1),
+        ];
+        reconcile_row_interp(&mut elems);
+        assert_eq!(elems[0].interp, 1);
+        assert_eq!(elems[1].interp, 1);
+        assert_eq!(elems[2].interp, 3);
+        assert_eq!(elems[3].interp, 3);
+    }
+}
