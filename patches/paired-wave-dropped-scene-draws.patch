+// Arithmetic only; readable, live external storage is still an ABI obligation.
+fn input_layout_extent_valid<T>(ptr: *const T, count: usize) -> bool {
+    if count == 0 {
+        return true;
+    }
+    let start = ptr as usize;
+    !ptr.is_null() && start % std::mem::align_of::<T>() == 0
+        && count.checked_mul(std::mem::size_of::<T>()).is_some_and(|bytes|
+            bytes <= isize::MAX as usize && start.checked_add(bytes).is_some())
+}
+
+// Match GraphicsState::elements' existing append and byte-width rules.
+fn input_offsets_valid(elements: impl IntoIterator<Item = (u32, u32, u32)>) -> bool {
+    let mut next = [0u32; 32];
+    for (slot, offset, bytes) in elements {
+        let Some(end) = next.get_mut(slot as usize) else { return false; };
+        let offset = if offset == u32::MAX { *end } else { offset };
+        let Some(after) = offset.checked_add(bytes) else { return false; };
+        *end = after;
+    }
+    true
+}
