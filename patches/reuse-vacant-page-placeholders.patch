     #[test]
+    fn vacant_pages_can_be_remapped_after_coalescing() {
+        const MEM_COALESCE_PLACEHOLDERS: u32 = 1;
+
+        let pages = allocate(2);
+        let a = XMemVirtualAlloc(
+            std::ptr::null_mut(),
+            2 * PAGE,
+            MEM_RESERVE | PAGES_64K,
+            0,
+            PAGE_READWRITE,
+        );
+        assert!(!a.is_null());
+        let b = a.wrapping_byte_add(PAGE);
+        for (address, page) in [(a, &pages[0]), (b, &pages[1])] {
+            assert_eq!(XMemMapPhysicalPages(address, 1, page), address);
+            // SAFETY: the first byte of each successfully mapped page is writable.
+            unsafe { address.cast::<u8>().write(if address == a { 17 } else { 29 }) };
+            assert_eq!(XMemMapPhysicalPages(address, 1, std::ptr::null()), address);
+        }
+        assert_eq!(XMemMapPhysicalPages(a, 1, &pages[0]), a);
+        assert_eq!(XMemMapPhysicalPages(a, 1, std::ptr::null()), a);
+        if cache_vacant_pages() {
+            assert!(physical().vacant_pages.contains(&(a as usize)));
+        }
+        // SAFETY: both adjacent pages are empty placeholders from one reservation.
+        assert_ne!(
+            unsafe { VirtualFree(a, 2 * PAGE, MEM_RELEASE | MEM_COALESCE_PLACEHOLDERS) },
+            0
+        );
+        assert_eq!(XMemMapPhysicalPages(a, 1, &pages[1]), a);
+        assert_eq!(XMemMapPhysicalPages(b, 1, &pages[0]), b);
+        // SAFETY: both mappings just succeeded with the swapped backing pages.
+        assert_eq!(unsafe { (a.cast::<u8>().read(), b.cast::<u8>().read()) }, (29, 17));
+        assert_eq!(XMemMapPhysicalPages(a, 2, std::ptr::null()), a);
+        assert_eq!(XMemFreePhysicalPages(2, pages.as_ptr()), 1);
+    }
